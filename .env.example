# ========================================================
# Configuración del Pipeline Autónomo de Google Flow y TikTok
# Copia este archivo a .env y completa tus credenciales:
# cp .env.example .env
# ========================================================

# 1. Configuración de LLM (Opencode Go / Claude / Deepseek / Kimi)
# Obtén tu clave en: https://opencode.ai
OPENCODE_API_KEY=tu_opencode_api_key_aqui
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=claude-haiku-5-5

# 2. Clave opcional de Google Gemini (respaldo alternativo)
# Obtén tu clave en Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash

# 3. Google Flow (Opcional - El bot detecta automáticamente tu pestaña activa)
# Si deseas fijar una URL de proyecto por defecto:
FLOW_PROJECT_URL=https://flow.google.com

# 4. Parámetros de conexión Chrome DevTools Protocol (CDP)
CDP_PORT=9222
