# ========================================================
# Configuración del Pipeline Autónomo de Google Flow y TikTok
# Copia este archivo a .env y completa tus credenciales:
# cp .env.example .env
# ========================================================

# --------------------------------------------------------
# 1. PROVEEDOR DE IA PARA GENERACIÓN DE HISTORIAS
# --------------------------------------------------------
# Opciones disponibles: gemini, opencode, openai, anthropic
# Si no se especifica, el sistema detectará automáticamente según las claves presentes.
AI_PROVIDER=gemini

# A. Google Gemini Oficial (Recomendado y gratuito en Google AI Studio)
# Obtén tu clave en: https://aistudio.google.com
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash

# B. Opencode Go (Acceso unificado a Kimi, Deepseek, Haiku, Qwen)
# Obtén tu clave en: https://opencode.ai
OPENCODE_API_KEY=tu_opencode_api_key_aqui
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-chat

# C. OpenAI Oficial (Opcional)
# Obtén tu clave en: https://platform.openai.com
OPENAI_API_KEY=tu_openai_api_key_aqui
OPENAI_MODEL=gpt-4o-mini

# D. Anthropic Claude Oficial (Opcional)
# Obtén tu clave en: https://console.anthropic.com
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --------------------------------------------------------
# 2. CONFIGURACIÓN GOOGLE FLOW Y CHROME DEVTOOLS (CDP)
# --------------------------------------------------------
# Si deseas fijar una URL de proyecto por defecto:
FLOW_PROJECT_URL=https://flow.google.com

# Puerto de conexión CDP (por defecto: 9222)
CDP_PORT=9222
